# =============================================================================
# Nimbus Environment Configuration Template (.env.example)
# Copy to .env and adjust variables for your target deployment environment.
# =============================================================================

# --- 1. Cloud Service & Target Endpoints ---
# Local development default:
NIMBUS_CLOUD_URL=http://127.0.0.1:8000
PORT=8000
DATA_DIR=data

# Deployed AWS API Gateway endpoint (e.g. for remote edge supervisors/runners):
# NIMBUS_CLOUD_URL=https://<api-id>.execute-api.<region>.amazonaws.com

# --- 2. Security & Authentication ---
# For local unit tests and development (bypasses auth when set to 1):
NIMBUS_AUTH_DISABLED=0

# Shared Master Token (grants all roles when set):
# NIMBUS_AUTH_TOKEN=your-master-token-here

# Role-specific Tokens (fail-closed in production if unset):
# NIMBUS_EDGE_TOKEN=your-edge-bearer-token
# NIMBUS_OPERATOR_TOKEN=your-operator-bearer-token
# NIMBUS_REQUESTER_TOKEN=your-requester-bearer-token
# NIMBUS_ADMIN_TOKEN=your-admin-bearer-token
# NIMBUS_FAULT_TOKEN=your-fault-injection-token

# --- 3. Cloud Backend & LLM ---
NIMBUS_BACKEND=local
# For AWS deployment:
# NIMBUS_BACKEND=aws
# AWS_REGION=ap-south-1
# NIMBUS_DDB_PREFIX=nimbus-ds252
# NIMBUS_RESULTS_BUCKET=nimbus-ds252-outputs
# NIMBUS_SQS_QUEUE_URL=https://sqs.ap-south-1.amazonaws.com/<account-id>/nimbus-ds252-escalations

# LLM Configuration:
NIMBUS_LLM=fake
# For AWS Bedrock:
# NIMBUS_LLM=bedrock
# NIMBUS_BEDROCK_MODEL=apac.amazon.nova-lite-v1:0

# Evaluation Mode: C1 (hybrid lease), C2 (cloud relay), C3 (rule/structured)
NIMBUS_MODE=C1

# --- 4. Pack & Simulation ---
NIMBUS_PACK=hospital_sim6
# Hand-made map pack:
# NIMBUS_PACK=hospital

# --- 5. Transport (HTTP / MQTT) ---
NIMBUS_TRANSPORT=http
# For MQTT transport:
# NIMBUS_TRANSPORT=mqtt
# NIMBUS_MQTT_HOST=localhost
# NIMBUS_MQTT_PORT=1883
# NIMBUS_MQTT_STANDIN=0
