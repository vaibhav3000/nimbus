            <specular>0.35 0.35 0.35 1</specular>
          </material>
        </visual>
        <sensor name="ultrasonic" type="gpu_lidar">
          <always_on>1</always_on>
          <update_rate>15</update_rate>
          <topic>/robot_1/ultrasonic/scan</topic>
          <lidar>
            <scan>
              <horizontal>
                <samples>5</samples>
                <resolution>1</resolution>
                <min_angle>-0.10</min_angle>
                <max_angle>0.10</max_angle>
              </horizontal>
              <vertical>
                <samples>1</samples>
                <resolution>1</resolution>
                <min_angle>0</min_angle>
                <max_angle>0</max_angle>
              </vertical>
            </scan>
            <range>
              <min>0.02</min>
              <max>4.0</max>
              <resolution>0.01</resolution>
            </range>
          </lidar>
        </sensor>
      </link>
      <joint name="front_range_joint" type="fixed">
        <parent>base_link</parent>
        <child>front_range_link</child>
      </joint>
      <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
        <left_joint>left_front_wheel_joint</left_joint>
        <left_joint>left_rear_wheel_joint</left_joint>
        <right_joint>right_front_wheel_joint</right_joint>
        <right_joint>right_rear_wheel_joint</right_joint>
        <left_steering_joint>left_front_steering_joint</left_steering_joint>
        <right_steering_joint>right_front_steering_joint</right_steering_joint>
        <kingpin_width>0.20</kingpin_width>
        <steering_limit>0.55</steering_limit>
        <wheel_base>0.325</wheel_base>
        <wheel_separation>0.20</wheel_separation>
        <wheel_radius>0.05</wheel_radius>
        <topic>/robot_1/cmd_vel</topic>
        <odom_topic>/robot_1/odom</odom_topic>
        <tf_topic>/robot_1/tf</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <frame_id>robot_1/odom</frame_id>
        <child_frame_id>robot_1/base_link</child_frame_id>
        <max_velocity>1.0</max_velocity>
        <min_velocity>-1.0</min_velocity>
        <max_acceleration>2.0</max_acceleration>
        <min_acceleration>-2.0</min_acceleration>
      </plugin>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
        <publish_link_pose>true</publish_link_pose>
        <publish_model_pose>true</publish_model_pose>
        <use_pose_vector_msg>true</use_pose_vector_msg>
        <static_publisher>true</static_publisher>
        <topic>/robot_1/pose</topic>
      </plugin>
    </model>
