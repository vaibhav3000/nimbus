        <odom_topic>/robot_4/odom</odom_topic>
        <tf_topic>/robot_4/tf</tf_topic>
        <odom_publish_frequency>30</odom_publish_frequency>
        <frame_id>robot_4/odom</frame_id>
        <child_frame_id>robot_4/base_link</child_frame_id>
        <max_velocity>1.0</max_velocity>
