<?xml version="1.0"?>
<sdf version="1.6">
  <model name="mit_racecar">
    <self_collide>false</self_collide>

    <!-- Upstream RACECAR reference frame: rear axle at x=0, ground at z=0.
         The deck is centred at z=0.05, and front kingpins are at x=0.325. -->
    <link name="base_link">
      <pose>0 0 0.05 0 0 0</pose>
      <inertial>
        <pose>0.1477 0 0 0 0 0</pose>
        <mass>4.0</mass>
        <inertia><ixx>0.010609</ixx><iyy>0.050409</iyy><izz>0.05865</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- Conservative physical approximation of the upstream deck mesh. -->
      <collision name="chassis_collision">
        <pose>0.1625 0 0 0 0 0</pose>
        <geometry><box><size>0.405 0.20 0.06</size></box></geometry>
        <surface><friction><ode><mu>0.8</mu><mu2>0.8</mu2></ode></friction></surface>
      </collision>
      <visual name="racecar_chassis_visual">
        <geometry><mesh><uri>model://mit_racecar/meshes/chassis.dae</uri></mesh></geometry>
        <material><ambient>0.05 0.22 0.65 1</ambient><diffuse>0.08 0.34 0.90 1</diffuse><specular>0.45 0.45 0.45 1</specular></material>
      </visual>
    </link>

    <!-- All four wheel links retain the upstream 0.05 m radius / 0.045 m
         tire width while using project-local Fortress joints and controller. -->
    <link name="left_rear_wheel">
      <pose>0 0.10 0.05 -1.5708 0 0</pose>
      <inertial><mass>0.34055</mass><inertia><ixx>0.00026046</ixx><iyy>0.00026046</iyy><izz>0.00041226</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 3.14159 0 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/left_rear_wheel.dae</uri></mesh></geometry><material><ambient>0.035 0.035 0.035 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse></material></visual>
    </link>
    <link name="right_rear_wheel">
      <pose>0 -0.10 0.05 -1.5708 0 0</pose>
      <inertial><mass>0.34055</mass><inertia><ixx>0.00026046</ixx><iyy>0.00026046</iyy><izz>0.00041226</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 3.14159 0 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/right_rear_wheel.dae</uri></mesh></geometry><material><ambient>0.035 0.035 0.035 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse></material></visual>
    </link>

    <!-- Front kingpin links are intentionally separate so their mesh and
         wheel visibly follow the same physical steering joint. -->
    <link name="left_front_steering_link">
      <pose relative_to="base_link">0.325 0.10 0 0 0 0</pose>
      <inertial><mass>0.100</mass><inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 0 1.5708 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/left_steering_hinge.dae</uri></mesh></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <link name="right_front_steering_link">
      <pose relative_to="base_link">0.325 -0.10 0 0 0 0</pose>
      <inertial><mass>0.100</mass><inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="visual"><pose>0 0 0 0 1.5708 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/right_steering_hinge.dae</uri></mesh></geometry><material><ambient>0.18 0.18 0.18 1</ambient><diffuse>0.18 0.18 0.18 1</diffuse></material></visual>
    </link>
    <link name="left_front_wheel">
      <pose relative_to="left_front_steering_link">0 0 0 -1.5708 0 0</pose>
      <inertial><mass>0.34055</mass><inertia><ixx>0.00026046</ixx><iyy>0.00026046</iyy><izz>0.00041226</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 3.14159 0 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/left_front_wheel.dae</uri></mesh></geometry><material><ambient>0.035 0.035 0.035 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse></material></visual>
    </link>
    <link name="right_front_wheel">
      <pose relative_to="right_front_steering_link">0 0 0 -1.5708 0 0</pose>
      <inertial><mass>0.34055</mass><inertia><ixx>0.00026046</ixx><iyy>0.00026046</iyy><izz>0.00041226</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="collision"><geometry><cylinder><radius>0.05</radius><length>0.045</length></cylinder></geometry><surface><friction><ode><mu>1.5</mu><mu2>1.5</mu2><fdir1>0 0 1</fdir1></ode></friction></surface></collision>
      <visual name="visual"><pose>0 0 0 3.14159 0 0</pose><geometry><mesh><uri>model://mit_racecar/meshes/right_front_wheel.dae</uri></mesh></geometry><material><ambient>0.035 0.035 0.035 1</ambient><diffuse>0.035 0.035 0.035 1</diffuse></material></visual>
    </link>

    <joint name="left_rear_wheel_joint" type="revolute"><parent>base_link</parent><child>left_rear_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint>
    <joint name="right_rear_wheel_joint" type="revolute"><parent>base_link</parent><child>right_rear_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint>
    <joint name="left_front_steering_joint" type="revolute"><parent>base_link</parent><child>left_front_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.60</lower><upper>0.60</upper><velocity>0.7</velocity><effort>10.0</effort></limit><use_parent_model_frame>1</use_parent_model_frame></axis></joint>
    <joint name="right_front_steering_joint" type="revolute"><parent>base_link</parent><child>right_front_steering_link</child><axis><xyz>0 0 1</xyz><limit><lower>-0.60</lower><upper>0.60</upper><velocity>0.7</velocity><effort>10.0</effort></limit><use_parent_model_frame>1</use_parent_model_frame></axis></joint>
    <joint name="left_front_wheel_joint" type="revolute"><parent>left_front_steering_link</parent><child>left_front_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint>
    <joint name="right_front_wheel_joint" type="revolute"><parent>right_front_steering_link</parent><child>right_front_wheel</child><axis><xyz>0 0 1</xyz><limit><lower>-1.79769e+308</lower><upper>1.79769e+308</upper></limit></axis></joint>

    <!-- Sensors use the source RACECAR's front ZED and Hokuyo mounting areas,
         but expose the stable project interfaces rather than upstream ROS APIs. -->
    <link name="front_camera_link">
      <pose relative_to="base_link">0.390 0 0.040 0 0 0</pose>
      <inertial><mass>0.00001</mass><inertia><ixx>0.000001</ixx><iyy>0.000001</iyy><izz>0.000001</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="camera_mount_visual"><geometry><box><size>0.033 0.175 0.030</size></box></geometry><material><ambient>0.40 0.04 0.04 1</ambient><diffuse>0.65 0.06 0.06 1</diffuse></material></visual>
      <sensor name="rgb_camera" type="camera">
        <always_on>1</always_on><update_rate>5</update_rate><topic>/picarx/camera/image</topic>
        <camera name="front_camera"><horizontal_fov>1.0472</horizontal_fov><image><width>320</width><height>240</height><format>R8G8B8</format></image><clip><near>0.05</near><far>20</far></clip></camera>
      </sensor>
    </link>
    <joint name="front_camera_joint" type="fixed"><parent>base_link</parent><child>front_camera_link</child></joint>

    <link name="front_range_link">
      <pose relative_to="base_link">0.265 0 0.075 0 0 0</pose>
      <inertial><mass>0.130</mass><inertia><ixx>0.000004</ixx><iyy>0.000004</iyy><izz>0.000004</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <visual name="hokuyo_visual"><geometry><mesh><uri>model://mit_racecar/meshes/hokuyo.dae</uri></mesh></geometry><material><ambient>0.10 0.10 0.12 1</ambient><diffuse>0.10 0.10 0.12 1</diffuse><specular>0.35 0.35 0.35 1</specular></material></visual>
      <sensor name="ultrasonic" type="gpu_lidar">
        <always_on>1</always_on><update_rate>15</update_rate><topic>/picarx/ultrasonic/scan</topic>
        <lidar><scan><horizontal><samples>181</samples><resolution>1</resolution><min_angle>-1.5708</min_angle><max_angle>1.5708</max_angle></horizontal><vertical><samples>1</samples><resolution>1</resolution><min_angle>0</min_angle><max_angle>0</max_angle></vertical></scan><range><min>0.02</min><max>4.0</max><resolution>0.01</resolution></range></lidar>
      </sensor>
    </link>
    <joint name="front_range_joint" type="fixed"><parent>base_link</parent><child>front_range_link</child></joint>

    <plugin filename="ignition-gazebo-ackermann-steering-system" name="ignition::gazebo::systems::AckermannSteering">
      <left_joint>left_front_wheel_joint</left_joint><left_joint>left_rear_wheel_joint</left_joint>
      <right_joint>right_front_wheel_joint</right_joint><right_joint>right_rear_wheel_joint</right_joint>
      <left_steering_joint>left_front_steering_joint</left_steering_joint>
      <right_steering_joint>right_front_steering_joint</right_steering_joint>
      <kingpin_width>0.20</kingpin_width><steering_limit>0.55</steering_limit>
      <wheel_base>0.325</wheel_base><wheel_separation>0.20</wheel_separation><wheel_radius>0.05</wheel_radius>
      <topic>/cmd_vel</topic><odom_topic>/odom</odom_topic><tf_topic>/tf</tf_topic>
      <odom_publish_frequency>30</odom_publish_frequency><frame_id>odom</frame_id><child_frame_id>base_link</child_frame_id>
      <max_velocity>0.5</max_velocity><min_velocity>-0.3</min_velocity>
      <max_acceleration>1.0</max_acceleration><min_acceleration>-1.0</min_acceleration>
    </plugin>
    <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
      <publish_link_pose>true</publish_link_pose><publish_model_pose>true</publish_model_pose><use_pose_vector_msg>true</use_pose_vector_msg><static_publisher>true</static_publisher>
      <topic>/picarx/pose</topic>
    </plugin>
  </model>
</sdf>
